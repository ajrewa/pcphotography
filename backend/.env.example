NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/pc_photo

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — the public site and the admin panel origins
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Seed script (first superadmin account)
SEED_ADMIN_EMAIL=admin@theweddingfilmer.com
SEED_ADMIN_PASSWORD=ChangeMe@123
